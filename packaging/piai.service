[Unit]
Description=Pi-AI Lab Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/piai /etc/piai/piai.conf
Restart=always
RestartSec=2
User=piai
Group=piai
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/piai

[Install]
WantedBy=multi-user.target
