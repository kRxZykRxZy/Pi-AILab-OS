#!/usr/bin/env python3
import argparse, json, os, platform, sys, urllib.request

API = os.getenv('PILAB_API', 'http://127.0.0.1:8787')

def get(path):
    with urllib.request.urlopen(API + path, timeout=10) as r:
        return json.load(r)

def post(path, data):
    req = urllib.request.Request(API + path, data=json.dumps(data).encode(), headers={'content-type':'application/json'}, method='POST')
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.load(r)

p = argparse.ArgumentParser(prog='pilab')
sub = p.add_subparsers(dest='cmd')
sub.add_parser('status')
sub.add_parser('models')
r = sub.add_parser('run'); r.add_argument('--model', required=True); r.add_argument('--prompt', required=True); r.add_argument('--max-tokens', type=int, default=128); r.add_argument('--threads', type=int, default=0); r.add_argument('--temperature', type=float, default=0.7)
a = p.parse_args()
if a.cmd == 'status': print(json.dumps(get('/api/v1/system'), indent=2))
elif a.cmd == 'models': print(json.dumps(get('/api/v1/models'), indent=2))
elif a.cmd == 'run':
    job = post('/api/v1/inference', {'model':a.model,'prompt':a.prompt,'max_tokens':a.max_tokens,'threads':a.threads,'temperature':a.temperature})
    print(json.dumps(job, indent=2)); print('Use GET /api/v1/jobs/' + job['job_id'] + ' to retrieve the result.')
else: p.print_help()
